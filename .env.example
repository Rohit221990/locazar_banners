# -------------------------------------------------------
# Locazar SDUI Server — Environment Variables
# -------------------------------------------------------
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to source control.

# --- Server ---
NODE_ENV=development
PORT=3002

# --- CORS ---
# Restrict the SDUI server to your Go backend origin.
# Example: http://localhost:8080
# Leave as * during local development only.
ALLOWED_ORIGIN=*

# --- Logging ---
# Set to "true" to enable verbose request logging
ENABLE_REQUEST_LOGGING=false
